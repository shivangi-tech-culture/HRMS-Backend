PORT=9001

# development → http://localhost:PORT
# production  → API_BASE_URL (Render sets NODE_ENV=production)
NODE_ENV=development
API_BASE_URL=https://hrms-backend-py1t.onrender.com
MONGODB_URI=mongodb://127.0.0.1:27017/hrms
JWT_SECRET=hrms_simple_secret_key_change_in_prod
JWT_EXPIRES_IN=7d

# Mail — Zoho SMTP (works on localhost; Render FREE blocks ports 465/587)
EMAIL_USER_EZ=noreply@yourdomain.com
EMAIL_PASS_EZ=your_smtp_password
SMTP_HOST_EZ=smtp.zoho.com
SMTP_PORT_EZ=465
EMAIL_FROM_NAME=TechCulture HR
# Render: set ONE HTTPS provider (required for live welcome mail on free tier)
# Brevo: https://app.brevo.com → SMTP & API → API keys (verify sender = EMAIL_USER_EZ)
# BREVO_API_KEY=xkeysib-...
# Or Resend: https://resend.com → API Keys
# RESEND_API_KEY=re_...
APP_URL=https://hrms-techculture.vercel.app
CLIENT_URL=https://hrms-techculture.vercel.app
# Default company on create user (when official.company omitted)
DEFAULT_COMPANY=TechCulture.Ai Private Limited
# Cloudinary (education document upload)
# If PDF opens with "Failed to load PDF document" → Cloudinary Console:
# Settings → Security → enable "Allow delivery of PDF and ZIP files"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="hrms/education"

# Security — rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_LOGIN_MAX=20

# Timezone for attendance / shifts (default India)
TZ=Asia/Kolkata

# Google Maps — reverse geocode (punch-in/out: lat/long → address saved in DB)
# Console: https://console.cloud.google.com/ → APIs → enable "Geocoding API" → create key
GOOGLE_MAPS_API_KEY=your_google_maps_geocoding_api_key_here

# ─── Firebase Cloud Messaging (web + Android + iOS push) ───
# Firebase Console → Project settings → Service accounts → Generate new private key
# Option A — paste the whole JSON as one line (escape " as needed):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
# Option B — split fields:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key: keep \n as literal backslash-n OR wrap in quotes with real newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Web Push certificates → Key pair → paste public key (frontend getToken vapidKey)
FIREBASE_WEB_VAPID_KEY=your_web_push_vapid_public_key
# Optional: cron job header for POST /api/notifications/remind-profile
NOTIFICATION_CRON_SECRET=change_me_long_random_string
