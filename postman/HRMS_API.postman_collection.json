  "item": [
    {
      "name": "0 Health",
      "item": [
        {
          "name": "API Root",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('API is working', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.status).to.eql('ok');",
                  "  pm.expect(j.message).to.eql('HRMS API is working');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Simple root check (no token).\n\nResponse:\n```json\n{\n  \"success\": true,\n  \"status\": \"ok\",\n  \"message\": \"HRMS API is working\",\n  \"name\": \"HRMS API\",\n  \"version\": \"1.0.0\"\n}\n```"
          }
        },
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('API healthy + MongoDB connected', function () {",
                  "  var j = pm.response.json();",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.status).to.eql('ok');",
                  "  pm.expect(j.mongodb).to.eql('connected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Public health check — no token.\nChecks API + MongoDB.\n\nHealthy (200):\n```json\n{\n  \"success\": true,\n  \"status\": \"ok\",\n  \"message\": \"HRMS API is healthy\",\n  \"mongodb\": \"connected\"\n}\n```\n\nDown (503):\n```json\n{\n  \"success\": false,\n  \"status\": \"down\",\n  \"message\": \"MongoDB is not connected\",\n  \"mongodb\": \"disconnected\"\n}\n```"
          }
        }
      ]
    },
    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Login Global Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);",
                  "if (j.user && j.user.id) pm.collectionVariables.set('userId', j.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officialEmail\": \"{{globalAdminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Global Admin — all companies.\nSets {{token}} + {{userId}}.\nEmail: globaladmin@techculture.ai (after npm run seed)."
          }
        },
        {
          "name": "Login Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);",
                  "if (j.user && j.user.id) pm.collectionVariables.set('userId', j.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officialEmail\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Super Admin — own company only.\nSets {{token}} + {{userId}}.\nThen use **Update Profile (Super Admin)** — full objects allowed."
          }
        },
        {
          "name": "Login Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);",
                  "if (j.user && j.user.id) pm.collectionVariables.set('userId', j.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"officialEmail\": \"{{employeeEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Sets {{token}} + {{userId}}.\nThen use **Update Profile (Employee)** — personal only (phones etc). No official{}."
          }
        }
      ]
    },
    {
      "name": "3 Roles",
      "item": [
        {
          "name": "Create Role",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.role && j.role.id) pm.collectionVariables.set('roleId', j.role.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{roleName}}\",\n  \"description\": \"{{roleDescription}}\",\n  \"status\": \"{{roleStatus}}\"\n}"
            },
            "url": "{{baseUrl}}/api/roles",
            "description": "Creates role. Sets {{roleId}}.\nVars: roleName, roleDescription, roleStatus"
          }
        },
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/roles"
          }
        },
        {
          "name": "Get Role Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/roles/{{roleId}}/permissions"
          }
        },
        {
          "name": "Update Role Permissions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    {\n      \"module\": \"Dashboard\",\n      \"heading\": \"Overview\",\n      \"subModules\": [\n        {\n          \"name\": \"Attendance Summary\",\n          \"view\": true,\n          \"create\": false,\n          \"edit\": false,\n          \"delete\": false,\n          \"approve\": false,\n          \"reject\": false,\n          \"download\": false,\n          \"export\": true,\n          \"import\": false,\n          \"upload\": false,\n          \"print\": false,\n          \"email\": false,\n          \"share\": false,\n          \"cancel\": false,\n          \"assign\": false\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/roles/{{roleId}}/permissions",
            "description": "Updates permissions for Employee, HR Manager, Manager, and custom roles.\nSuper Admin is rejected — that role always has full access.\nSet {{roleId}} to the role you want to edit, not Super Admin.\nMissing pages are saved as false."
          }
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/roles/{{roleId}}",
            "description": "Super Admin cannot be deleted.\nEmployee, HR Manager, Manager, and custom roles can be deleted when no user has that role.\nLogin as Super Admin. Set {{roleId}} to the role to delete."
          }
        }
      ]
    },
    {
      "name": "4 Employees (Users)",
      "description": "Same PUT update API for everyone.\nLogin Super Admin → Update Profile (Super Admin)\nLogin Employee → Update Profile (Employee)",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.employee && j.employee._id) pm.collectionVariables.set('userId', j.employee._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{newUserName}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{userRole}}\",\n  \"status\": \"{{userStatus}}\",\n  \"official\": {\n    \"officialEmail\": \"{{newUserEmail}}\",\n    \"employeeCode\": \"{{employeeCode}}\",\n    \"company\": \"{{company}}\",\n    \"department\": \"{{department}}\"\n  },\n  \"personal\": {\n    \"mobileNo\": \"{{mobileNo}}\",\n    \"presentAddress\": {\n      \"city\": \"{{city}}\",\n      \"state\": \"{{state}}\",\n      \"country\": \"{{country}}\"\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/api/employees",
            "description": "Global Admin / Super Admin / HR Manager / Manager.\n\nBody same as User model (nested):\n- official.officialEmail, company, department (required)\n- personal.mobileNo, presentAddress (optional)\n\nCompany: Global Admin → any; others → own company only.\nSets {{userId}} from response.\n\nFull profile: use Create Employee (full profile)."
          }
        },
